<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,6,32,28">
      <TextBlock Style="{StaticResource T.Title}" Text="Settings"/>
      <TextBlock Style="{StaticResource T.Subtitle}" Text="Make PC Manager work the way you like."/>

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}">
            <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Text="&#xE790;"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Text="Theme"/>
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,2,0,0" Text="System follows your Windows light or dark setting."/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="SetThemeSystem" Style="{StaticResource Choice}" GroupName="Theme" Content="System" Tag="System"/>
            <RadioButton x:Name="SetThemeLight" Style="{StaticResource Choice}" GroupName="Theme" Content="Light" Tag="Light"/>
            <RadioButton x:Name="SetThemeDark" Style="{StaticResource Choice}" GroupName="Theme" Content="Dark" Tag="Dark" Margin="0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}">
            <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Text="&#xE74D;"/>
          </Border>
          <CheckBox x:Name="SetConfirm" Grid.Column="1" Style="{StaticResource Toggle}" Margin="14,0,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Text="Ask before deleting files"/>
              <TextBlock Style="{StaticResource T.Sub}" Margin="0,2,0,0" Text="Shows what will be removed before Fix all and Clean now. Emptying the Recycle Bin always asks."/>
            </StackPanel>
          </CheckBox>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardStyle}" Padding="12,16">
        <StackPanel>
          <Grid Margin="10,0,6,8">
            <TextBlock Style="{StaticResource T.Section}" Text="Recent activity" Margin="0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="SetOpenLog" Style="{StaticResource Btn.Link}" Content="Open full log"/>
              <Button x:Name="SetOpenReports" Style="{StaticResource Btn.Link}" Content="Open reports folder"/>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="SetActivity"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="11" VerticalAlignment="Top">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6A9BFF" Offset="0"/>
                <GradientStop Color="#2F5FE3" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" FontSize="15" Text="PC Manager 2.0"/>
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="Runs entirely on this PC. Nothing is installed, and nothing is sent anywhere."/>
            <TextBlock x:Name="SetAdminText" Style="{StaticResource T.Sub}" Margin="0,4,0,0"/>
            <TextBlock x:Name="SetDataText" Style="{StaticResource T.Caption}" Margin="0,10,0,14"/>
            <Button x:Name="SetShortcutBtn" Content="Add desktop shortcut" HorizontalAlignment="Left"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
