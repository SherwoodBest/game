<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,6,32,28">
      <TextBlock Style="{StaticResource T.Title}" Text="Running apps"/>
      <TextBlock Style="{StaticResource T.Subtitle}" Text="What is using your memory and processor right now, biggest first. Ending an app closes it straight away, so save your work in it first."/>

      <Border Style="{StaticResource CardStyle}" Padding="24,20">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconTile}" Width="52" Height="52" CornerRadius="13">
              <TextBlock Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Text="&#xE9D9;"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
              <TextBlock x:Name="ProcSummary" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Text="Measuring..."/>
              <TextBlock x:Name="ProcSummarySub" Style="{StaticResource T.Sub}" Margin="0,3,0,0" Text="Watching your apps for a second."/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="ProcSearch" Width="230" Tag="Search running apps"/>
              <Button x:Name="ProcRefresh" Style="{StaticResource Btn.Icon}" Content="&#xE72C;" ToolTip="Refresh" Margin="8,0,0,0"/>
            </StackPanel>
          </Grid>
          <ProgressBar x:Name="ProcMemBar" Style="{StaticResource Bar}" Margin="70,16,0,0" Value="0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}" Padding="12,10,12,12">
        <StackPanel>
          <Grid Margin="62,4,12,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="64"/>
              <ColumnDefinition Width="104"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource T.Caption}" Text="APP"/>
            <TextBlock Grid.Column="1" Style="{StaticResource T.Caption}" Text="MEMORY" Margin="16,0,0,0"/>
            <TextBlock Grid.Column="2" Style="{StaticResource T.Caption}" Text="CPU" HorizontalAlignment="Right"/>
          </Grid>
          <StackPanel x:Name="ProcList"/>
          <TextBlock x:Name="ProcFooter" Style="{StaticResource T.Caption}" Margin="12,10,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
