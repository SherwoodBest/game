<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,6,32,28">
      <TextBlock x:Name="HomeGreeting" Style="{StaticResource T.Title}" Text="Welcome"/>
      <TextBlock Style="{StaticResource T.Subtitle}" Text="Here is how your PC is doing."/>

      <!-- Health hero -->
      <Border Style="{StaticResource Card}" Padding="28,26">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="172" Height="172" VerticalAlignment="Center">
            <Ellipse Width="172" Height="172" StrokeThickness="12" Stroke="{DynamicResource Track}"/>
            <Ellipse x:Name="HomeRing" Width="172" Height="172" StrokeThickness="12" Stroke="{DynamicResource Accent}"
                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Opacity="0">
              <Ellipse.RenderTransform>
                <RotateTransform Angle="-90"/>
              </Ellipse.RenderTransform>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Name="HomeScore" Text="--" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Text}"/>
              <TextBlock Text="Health score" Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1" Margin="36,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="HomeStatusTitle" FontSize="21" FontWeight="SemiBold" Text="Let's check your PC"
                       Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
            <TextBlock x:Name="HomeStatusText" Style="{StaticResource T.Body}" Foreground="{DynamicResource TextSub}" Margin="0,6,0,18"
                       Text="A quick scan looks at storage, junk files, memory, startup apps and battery health."/>
            <StackPanel x:Name="HomeButtons" Orientation="Horizontal">
              <Button x:Name="HomeScanBtn" Style="{StaticResource Btn.Big}" Content="Scan now" Margin="0,0,10,0"/>
              <Button x:Name="HomeFixBtn" Style="{StaticResource Btn.Big}" Content="Fix all" Margin="0,0,10,0" Visibility="Collapsed"/>
              <Button x:Name="HomeRescanBtn" Content="Scan again" MinHeight="42" Padding="20,10" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel x:Name="HomeProgressBox" Visibility="Collapsed" MaxWidth="460" HorizontalAlignment="Left">
              <ProgressBar x:Name="HomeProgress" Style="{StaticResource Bar}" Width="420" Value="0"/>
              <TextBlock x:Name="HomeProgressText" Style="{StaticResource T.Sub}" Margin="0,8,0,0" Text="Starting..."/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Recommendations -->
      <Border x:Name="HomeIssuesCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="12,16">
        <StackPanel>
          <TextBlock Style="{StaticResource T.Section}" Text="Recommendations" Margin="10,0,0,8"/>
          <StackPanel x:Name="HomeIssues"/>
        </StackPanel>
      </Border>

      <!-- Quick actions -->
      <TextBlock Style="{StaticResource T.Section}" Text="Quick actions" Margin="2,6,0,12"/>
      <WrapPanel x:Name="HomeQuick" Margin="0,0,-14,4"/>

      <!-- System summary -->
      <Grid Margin="0,2,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource T.Section}" Text="This PC"/>
            <StackPanel x:Name="HomeInfo">
              <TextBlock Style="{StaticResource T.Sub}" Text="Details appear after the first scan."/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource T.Section}" Text="Usage"/>
            <StackPanel x:Name="HomeUsage">
              <TextBlock Style="{StaticResource T.Sub}" Text="Details appear after the first scan."/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Grid>
