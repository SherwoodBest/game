<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,6,32,28">
      <TextBlock Style="{StaticResource T.Title}" Text="Installed apps"/>
      <TextBlock Style="{StaticResource T.Subtitle}" Text="Everything installed on this PC. Removing apps you never use frees space and often stops background updaters too."/>

      <Border Style="{StaticResource Card}" Padding="24,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}" Width="52" Height="52" CornerRadius="13">
            <TextBlock Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Text="&#xE71D;"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
            <TextBlock x:Name="AppsSummary" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Text="Loading apps..."/>
            <TextBlock x:Name="AppsSummarySub" Style="{StaticResource T.Sub}" Margin="0,3,0,0" Text="Uninstall opens the app's own uninstaller, so you can see each step."/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBox x:Name="AppsSearch" Width="230" Tag="Search apps"/>
              <Button x:Name="AppsRefresh" Style="{StaticResource Btn.Icon}" Content="&#xE72C;" ToolTip="Refresh" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,42,0">
              <TextBlock Style="{StaticResource T.Sub}" Text="Sort by" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <RadioButton x:Name="AppsSortName" Style="{StaticResource Choice}" GroupName="AppsSort" Content="Name" Tag="Name" IsChecked="True"/>
              <RadioButton x:Name="AppsSortSize" Style="{StaticResource Choice}" GroupName="AppsSort" Content="Size" Tag="Size"/>
              <RadioButton x:Name="AppsSortDate" Style="{StaticResource Choice}" GroupName="AppsSort" Content="Date" Tag="Date" Margin="0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Padding="12,12">
        <StackPanel x:Name="AppsList"/>
      </Border>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}">
            <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Text="&#xE946;"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Text="Apps from the Microsoft Store"/>
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,2,0,0" Text="Store apps are listed and removed in Windows Settings."/>
          </StackPanel>
          <Button x:Name="AppsSettingsBtn" Grid.Column="2" Content="Apps settings" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
