<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,6,32,28">
      <TextBlock Style="{StaticResource T.Title}" Text="Startup apps"/>
      <TextBlock Style="{StaticResource T.Subtitle}" Text="These apps open by themselves when you sign in. Turn off the ones you do not need straight away - they stay installed, and you can still open them any time."/>

      <Border Style="{StaticResource CardStyle}" Padding="24,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}" Width="52" Height="52" CornerRadius="13">
            <TextBlock Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Text="&#xE7E8;"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
            <TextBlock x:Name="StartupSummary" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Text="Startup apps"/>
            <TextBlock x:Name="StartupSummarySub" Style="{StaticResource T.Sub}" Margin="0,3,0,0" Text="Fewer startup apps means Windows is ready sooner after you sign in."/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="StartupSearch" Width="230" Tag="Search apps"/>
            <Button x:Name="StartupRefresh" Style="{StaticResource Btn.Icon}" Content="&#xE72C;" ToolTip="Refresh" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardStyle}" Padding="12,12">
        <StackPanel x:Name="StartupList"/>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}">
            <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Text="&#xE946;"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Text="Apps from the Microsoft Store"/>
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,2,0,0" Text="Store apps such as Spotify or Teams manage their startup in Windows Settings."/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="StartupSettingsBtn" Content="Startup settings" Margin="0,0,8,0"/>
            <Button x:Name="StartupTaskMgrBtn" Content="Task Manager"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
