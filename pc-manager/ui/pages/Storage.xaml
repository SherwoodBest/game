<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,6,32,28">
      <TextBlock Style="{StaticResource T.Title}" Text="Storage"/>
      <TextBlock Style="{StaticResource T.Subtitle}" Text="See how full your drives are, and find big files you may no longer need."/>

      <WrapPanel x:Name="StorageDrives" Margin="0,0,-16,0"/>

      <Border Style="{StaticResource Card}" Padding="12,18,12,12">
        <StackPanel>
          <Grid Margin="10,0,8,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource T.Section}" Text="Large files" Margin="0,0,0,2"/>
              <TextBlock Style="{StaticResource T.Sub}" Text="Looks in your own folders (Desktop, Documents, Downloads, Videos and more). Deleted files go to the Recycle Bin."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <TextBlock Style="{StaticResource T.Sub}" Text="Bigger than" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <RadioButton x:Name="LargeSize100" Style="{StaticResource Choice}" GroupName="LargeSize" Content="100 MB" Tag="104857600"/>
              <RadioButton x:Name="LargeSize500" Style="{StaticResource Choice}" GroupName="LargeSize" Content="500 MB" Tag="524288000" IsChecked="True"/>
              <RadioButton x:Name="LargeSize1000" Style="{StaticResource Choice}" GroupName="LargeSize" Content="1 GB" Tag="1073741824" Margin="0,0,14,0"/>
              <Button x:Name="LargeFindBtn" Style="{StaticResource Btn.Accent}" Content="Find large files"/>
              <Button x:Name="LargeCancelBtn" Content="Cancel" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="LargeProgressBox" Margin="10,0,10,12" Visibility="Collapsed">
            <ProgressBar x:Name="LargeProgress" Style="{StaticResource Bar}" Value="0"/>
            <TextBlock x:Name="LargeProgressText" Style="{StaticResource T.Sub}" Margin="0,8,0,0" Text="Starting..."/>
          </StackPanel>
          <TextBlock x:Name="LargeSummary" Style="{StaticResource T.Body}" FontWeight="SemiBold" Margin="10,0,0,8" Visibility="Collapsed"/>
          <StackPanel x:Name="LargeList"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource T.Section}" Text="More ways to free up space"/>
          <WrapPanel>
            <Button x:Name="StorageDownloadsBtn" Content="Open Downloads folder" Margin="0,0,10,0"/>
            <Button x:Name="StorageRecycleBtn" Content="Open Recycle Bin" Margin="0,0,10,0"/>
            <Button x:Name="StorageSettingsBtn" Content="Storage settings" Margin="0,0,10,0"/>
            <Button x:Name="StorageCleanupBtn" Content="Disk Cleanup"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
