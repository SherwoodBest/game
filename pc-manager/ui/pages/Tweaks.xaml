<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,6,32,28">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource T.Title}" Text="Tweaks"/>
          <TextBlock Style="{StaticResource T.Subtitle}" Text="Fine-tune Windows for speed, gaming and battery life. Every switch shows the current setting, and you can flip it back any time."/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
          <Button x:Name="TweaksRefresh" Style="{StaticResource Btn.Icon}" Content="&#xE72C;" ToolTip="Refresh" Margin="0,0,8,0"/>
          <Button x:Name="TweaksApplyBtn" Style="{StaticResource Btn.Accent}" Content="Apply suggested"/>
        </StackPanel>
      </Grid>

      <StackPanel x:Name="TweakGroups"/>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconTile}">
            <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Text="&#xE790;"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Text="Visual effects"/>
            <TextBlock Style="{StaticResource T.Sub}" Margin="0,2,0,0"
                       Text="On older laptops, choose 'Adjust for best performance', then tick 'Smooth edges of screen fonts' so text stays easy to read."/>
          </StackPanel>
          <Button x:Name="TweaksVisualBtn" Grid.Column="2" Content="Visual effects options" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
